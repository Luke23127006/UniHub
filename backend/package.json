{
  "scripts": {
    "postinstall": "prisma generate --schema src/prisma/schema.prisma",
    "dev": "nodemon -L server.js",
    "start": "node server.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:load": "k6 run src/tests/loadtest.js",
    "csv:generate": "python data/generate_students_csv.py",
    "csv:sync": "node src/jobs/csvSyncWorker.js",
    "csv:test": "node src/jobs/csvSyncWorker.test.js",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "src/jobs/csvSyncWorker.test.js"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "amqplib": "^1.0.7",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "rate-limiter-flexible": "^11.1.0",
    "redlock": "^5.0.0-beta.2"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2"
  },
  "prisma": {
    "seed": "node src/prisma/seed.js"
  }
}

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum LoginStatus {
  success
  failed
}

enum CsvSyncStatus {
  pending
  processing
  completed
  failed
}

enum UploadStatus {
  uploaded
  processing
  done
  failed
}

enum AiSummaryStatus {
  pending
  processing
  completed
  failed
}

enum WorkshopStatus {
  draft
  published
  cancelled
  completed
}

enum RegistrationStatus {
  pending_payment
  confirmed
  cancelled
  waitlisted
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

enum NotificationChannel {
  app
  email
  telegram
}

enum NotificationEventStatus {
  queued
  processing
  sent
  failed
}

enum NotificationLogStatus {
  sent
  failed
  bounced
}

enum OfflineSyncStatus {
  pending
  processing
  completed
  partial_failed
}

// ============================================================
// RBAC
// ============================================================

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now())

  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@map("roles")
}

model Permission {
  id          BigInt  @id @default(autoincrement())
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  role_permissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  role_id       BigInt   @map("role_id")
  permission_id BigInt   @map("permission_id")
  granted_at    DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model User {
  id            BigInt    @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password_hash String?   @db.VarChar(255)
  full_name     String?   @db.VarChar(255)
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user_roles           UserRole[]           @relation("UserRoles")
  assigned_roles       UserRole[]           @relation("RoleAssigner")
  user_sessions        UserSession[]
  login_logs           LoginLog[]
  student              Student?
  created_workshops    Workshop[]
  uploaded_documents   WorkshopDocument[]
  idempotency_keys     IdempotencyKey[]
  scanned_checkins     Checkin[]
  offline_sync_batches OfflineSyncBatch[]
  notification_events  NotificationEvent[]

  @@map("users")
}

model UserRole {
  user_id     BigInt   @map("user_id")
  role_id     BigInt   @map("role_id")
  assigned_at DateTime @default(now())
  assigned_by BigInt?  @map("assigned_by")

  user     User  @relation("UserRoles", fields: [user_id], references: [id])
  role     Role  @relation(fields: [role_id], references: [id])
  assigner User? @relation("RoleAssigner", fields: [assigned_by], references: [id])

  @@id([user_id, role_id])
  @@map("user_roles")
}

// ============================================================
// AUTHENTICATION & AUDIT
// ============================================================

model UserSession {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt
  token_hash  String    @unique @db.VarChar(512)
  device_info String?   @db.VarChar(500)
  ip_address  String?   @db.VarChar(45)
  expires_at  DateTime
  revoked_at  DateTime?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("user_sessions")
}

model LoginLog {
  id             BigInt      @id @default(autoincrement())
  user_id        BigInt?
  ip_address     String?     @db.VarChar(45)
  status         LoginStatus
  failure_reason String?     @db.VarChar(255)
  created_at     DateTime    @default(now())

  user User? @relation(fields: [user_id], references: [id])

  @@map("login_logs")
}

// ============================================================
// STUDENT MANAGEMENT
// ============================================================

model Student {
  id              BigInt    @id @default(autoincrement())
  user_id         BigInt?   @unique
  student_code    String    @unique @db.VarChar(20)
  full_name       String    @db.VarChar(255)
  email           String    @db.VarChar(255)
  faculty         String?   @db.VarChar(255)
  major           String?   @db.VarChar(255)
  enrollment_year Int?      @db.SmallInt
  is_active       Boolean   @default(true)
  synced_at       DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user          User?          @relation(fields: [user_id], references: [id])
  registrations Registration[]

  @@map("students")
}

model CsvSyncLog {
  id             BigInt        @id @default(autoincrement())
  file_name      String        @db.VarChar(255)
  file_path      String        @db.VarChar(500)
  status         CsvSyncStatus @default(pending)
  total_rows     Int?
  processed_rows Int?
  skipped_rows   Int?
  error_rows     Int?
  error_details  String?
  started_at     DateTime?
  completed_at   DateTime?
  created_at     DateTime      @default(now())

  @@map("csv_sync_logs")
}

// ============================================================
// VENUE & WORKSHOP
// ============================================================

model Room {
  id               BigInt   @id @default(autoincrement())
  room_code        String   @unique @db.VarChar(50)
  name             String   @db.VarChar(255)
  capacity         Int
  building         String?  @db.VarChar(100)
  floor            Int?     @db.SmallInt
  layout_image_url String?  @db.VarChar(500)
  is_active        Boolean  @default(true)

  workshops Workshop[]

  @@map("rooms")
}

model Speaker {
  id           BigInt  @id @default(autoincrement())
  full_name    String  @db.VarChar(255)
  title        String? @db.VarChar(255)
  organization String? @db.VarChar(255)
  bio          String?
  avatar_url   String? @db.VarChar(500)

  workshop_speakers WorkshopSpeaker[]

  @@map("speakers")
}

model Workshop {
  id               BigInt         @id @default(autoincrement())
  title            String         @db.VarChar(500)
  description      String?
  room_id          BigInt
  event_day        DateTime       @db.Date
  start_time       DateTime
  end_time         DateTime
  capacity         Int
  available_seats  Int
  is_paid          Boolean        @default(false)
  price            Decimal?       @db.Decimal(12, 2)
  status           WorkshopStatus @default(draft)
  cancelled_reason String?        @db.VarChar(500)
  created_by       BigInt
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  room               Room               @relation(fields: [room_id], references: [id])
  creator            User               @relation(fields: [created_by], references: [id])
  workshop_speakers  WorkshopSpeaker[]
  workshop_documents WorkshopDocument[]
  ai_summaries       AiSummary[]
  registrations      Registration[]
  stats_cache        WorkshopStatsCache?

  @@map("workshops")
}

model WorkshopSpeaker {
  workshop_id     BigInt @map("workshop_id")
  speaker_id      BigInt @map("speaker_id")
  is_main_speaker Boolean @default(false)
  display_order   Int?   @db.SmallInt

  workshop Workshop @relation(fields: [workshop_id], references: [id])
  speaker  Speaker  @relation(fields: [speaker_id], references: [id])

  @@id([workshop_id, speaker_id])
  @@map("workshop_speakers")
}

// ============================================================
// AI SUMMARY
// ============================================================

model WorkshopDocument {
  id                 BigInt       @id @default(autoincrement())
  workshop_id        BigInt
  original_file_name String       @db.VarChar(255)
  storage_path       String       @db.VarChar(500)
  file_size_bytes    BigInt?
  mime_type          String?      @db.VarChar(100)
  upload_status      UploadStatus @default(uploaded)
  uploaded_by        BigInt
  uploaded_at        DateTime     @default(now())

  workshop     Workshop    @relation(fields: [workshop_id], references: [id])
  uploader     User        @relation(fields: [uploaded_by], references: [id])
  ai_summaries AiSummary[]

  @@map("workshop_documents")
}

model AiSummary {
  id           BigInt          @id @default(autoincrement())
  workshop_id  BigInt
  document_id  BigInt
  raw_text     String?
  summary_text String?
  ai_model     String?         @db.VarChar(100)
  status       AiSummaryStatus @default(pending)
  retry_count  Int             @default(0) @db.SmallInt
  last_error   String?
  created_at   DateTime        @default(now())
  completed_at DateTime?

  workshop Workshop         @relation(fields: [workshop_id], references: [id])
  document WorkshopDocument @relation(fields: [document_id], references: [id])

  @@map("ai_summaries")
}

// ============================================================
// REGISTRATION & PAYMENT
// ============================================================

model Registration {
  id                  BigInt             @id @default(autoincrement())
  student_id          BigInt
  workshop_id         BigInt
  status              RegistrationStatus @default(pending_payment)
  registered_at       DateTime           @default(now())
  confirmed_at        DateTime?
  cancelled_at        DateTime?
  cancellation_reason String?            @db.VarChar(500)

  student  Student  @relation(fields: [student_id], references: [id])
  workshop Workshop @relation(fields: [workshop_id], references: [id])
  payment  Payment?
  qr_code  QrCode?
  checkin  Checkin?

  @@unique([student_id, workshop_id])
  @@map("registrations")
}

model Payment {
  id               BigInt        @id @default(autoincrement())
  registration_id  BigInt        @unique
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @db.Char(3)
  gateway          String?       @db.VarChar(100)
  gateway_txn_id   String?       @db.VarChar(255)
  status           PaymentStatus @default(pending)
  payload_request  String?
  payload_response String?
  initiated_at     DateTime      @default(now())
  completed_at     DateTime?
  expires_at       DateTime?

  registration Registration @relation(fields: [registration_id], references: [id])

  @@map("payments")
}

model IdempotencyKey {
  id              BigInt    @id @default(autoincrement())
  key_hash        String    @unique @db.VarChar(128)
  user_id         BigInt
  resource_type   String    @db.VarChar(100)
  resource_id     BigInt?
  response_status Int?      @db.SmallInt
  response_body   String?
  expires_at      DateTime
  created_at      DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("idempotency_keys")
}

model QrCode {
  id              BigInt    @id @default(autoincrement())
  registration_id BigInt    @unique
  code            String    @unique @db.VarChar(128)
  qr_image_url    String?   @db.VarChar(500)
  is_valid        Boolean   @default(true)
  expires_at      DateTime?
  generated_at    DateTime  @default(now())

  registration Registration @relation(fields: [registration_id], references: [id])
  checkins     Checkin[]

  @@map("qr_codes")
}

// ============================================================
// CHECK-IN
// ============================================================

model Checkin {
  id                 BigInt    @id @default(autoincrement())
  registration_id    BigInt    @unique
  scanned_by_user_id BigInt
  qr_code_id         BigInt
  is_offline         Boolean   @default(false)
  device_id          String?   @db.VarChar(255)
  client_timestamp   DateTime?
  server_timestamp   DateTime  @default(now())
  synced_at          DateTime?
  created_at         DateTime  @default(now())

  registration Registration @relation(fields: [registration_id], references: [id])
  scanned_by   User         @relation(fields: [scanned_by_user_id], references: [id])
  qr_code      QrCode       @relation(fields: [qr_code_id], references: [id])

  @@map("checkins")
}

model OfflineSyncBatch {
  id             BigInt            @id @default(autoincrement())
  device_id      String            @db.VarChar(255)
  staff_user_id  BigInt
  batch_data     String
  total_records  Int?
  synced_records Int?
  failed_records Int?
  sync_status    OfflineSyncStatus @default(pending)
  created_at     DateTime          @default(now())
  synced_at      DateTime?

  staff_user User @relation(fields: [staff_user_id], references: [id])

  @@map("offline_sync_batches")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model NotificationTemplate {
  id               BigInt              @id @default(autoincrement())
  event_type       String              @db.VarChar(100)
  channel          NotificationChannel
  subject_template String?             @db.VarChar(500)
  body_template    String
  is_active        Boolean             @default(true)
  updated_at       DateTime            @updatedAt

  @@map("notification_templates")
}

model NotificationEvent {
  id                  BigInt                  @id @default(autoincrement())
  event_type          String                  @db.VarChar(100)
  recipient_user_id   BigInt
  related_entity_type String?                 @db.VarChar(100)
  related_entity_id   BigInt?
  payload             String?
  status              NotificationEventStatus @default(queued)
  retry_count         Int                     @default(0) @db.SmallInt
  next_retry_at       DateTime?
  created_at          DateTime                @default(now())
  processed_at        DateTime?

  recipient         User              @relation(fields: [recipient_user_id], references: [id])
  notification_logs NotificationLog[]

  @@map("notification_events")
}

model NotificationLog {
  id                BigInt                @id @default(autoincrement())
  event_id          BigInt
  channel           NotificationChannel
  recipient_address String                @db.VarChar(500)
  status            NotificationLogStatus
  error_message     String?
  sent_at           DateTime?

  event NotificationEvent @relation(fields: [event_id], references: [id])

  @@map("notification_logs")
}

// ============================================================
// STATISTICS CACHE
// ============================================================

model WorkshopStatsCache {
  id                      BigInt    @id @default(autoincrement())
  workshop_id             BigInt    @unique
  total_registrations     Int       @default(0)
  confirmed_registrations Int       @default(0)
  checked_in_count        Int       @default(0)
  available_seats         Int       @default(0)
  fill_rate               Decimal?  @db.Decimal(5, 2)
  total_revenue           Decimal?  @db.Decimal(12, 2)
  last_refreshed_at       DateTime?

  workshop Workshop @relation(fields: [workshop_id], references: [id])

  @@map("workshop_stats_cache")
}

# Database Configuration
POSTGRES_USER=unihub_admin
POSTGRES_PASSWORD=unihub_secret
POSTGRES_DB=unihub_workshop_db
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@unihub.com
PGADMIN_DEFAULT_PASSWORD=admin

# Redis Configuration
REDIS_PORT=6379
LOCK_TTL_MS=5000

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin

# Backend Configuration
DATABASE_URL=postgresql://unihub_admin:unihub_secret@postgres:5432/unihub_workshop_db?schema=public
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672
PORT=3000

# K6 Configuration
K6_API_URL=http://backend:3000/api/v1/workshops/1/register

# Security Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
QR_SECRET=unihub-qr-secret

# Mock Payment Gateway (Internal Docker access)
MOCK_PAYMENT_GATEWAY_URL=http://payment-gateway:4000

# Frontend Configuration (Optional Override)
# VITE_API_URL=http://localhost:3000
